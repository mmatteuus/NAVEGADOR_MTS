{
  "manifest_version": 3,
  "name": "NAVEGADOR MTS",
  "version": "2.1.2",
  "description": "Ponte de automação web ultrarresistente para controle por agentes de IA e integração MCP local no Windows 11.",
  "permissions": [
    "tabs",
    "activeTab",
    "scripting",
    "alarms",
    "storage",
    "debugger"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background/service_worker.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "NAVEGADOR MTS",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content/content_bridge.js",
        "content/dom_extractor.js",
        "content/element_finder.js",
        "content/interaction_simulator.js",
        "content/keyboard_scroll.js",
        "content/eval_runner.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
